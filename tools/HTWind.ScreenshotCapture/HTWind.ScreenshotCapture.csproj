<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>HTWind.ScreenshotCapture.Program</StartupObject>
    <!-- Manual developer tool, intentionally NOT part of HTWind.slnx so CI never runs it. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HTWind\HTWind.csproj" />
  </ItemGroup>

  <!--
    When the real App runs in-process, WPF resolves pack application URIs (e.g. the window
    icons) against Application.ResourceAssembly, which is this host. Mirror the assets the
    app embeds so the BAML resources load (same workaround as HTWind.E2ETests).
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\favicon.ico" Link="Assets\favicon.ico" />
  </ItemGroup>

</Project>
