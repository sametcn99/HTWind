<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!--
    When the real App runs in-process, WPF resolves pack application URIs (e.g. the window
    icons) against Application.ResourceAssembly, which is this test host. Mirror the assets
    the app embeds so the BAML resources load.
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\favicon.ico" Link="Assets\favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HTWind\HTWind.csproj" />
  </ItemGroup>

</Project>
