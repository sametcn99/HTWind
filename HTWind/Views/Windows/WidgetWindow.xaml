<Window
  x:Class="HTWind.WidgetWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:loc="clr-namespace:HTWind.Localization"
  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
  Title="{loc:Loc WidgetWindow_Title}"
  Height="300"
  Width="300"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  Topmost="True"
  ShowInTaskbar="False"
  MinWidth="160"
  MinHeight="100">
  <Grid Background="#01000000">
    <Border x:Name="WidgetChrome"
        Background="#B01A1A1A"
        CornerRadius="10"
        Margin="0">
      <Grid x:Name="WebViewHost"
          Margin="8,28,8,8">
        <wv2:WebView2 Name="webView"
            DefaultBackgroundColor="Transparent"/>
      </Grid>
    </Border>

    <!-- Drag surface sits above WebView2 area to avoid WebView2 airspace issues. -->
    <Border
      Name="DragOverlay"
      Height="20"
      Margin="8,6,60,0"
      VerticalAlignment="Top"
      Background="#70000000"
      CornerRadius="6"
      MouseLeftButtonDown="DragOverlay_MouseLeftButtonDown"
      MouseLeftButtonUp="DragOverlay_MouseLeftButtonUp"
      MouseMove="DragOverlay_MouseMove"
      ToolTip="{loc:Loc WidgetWindow_DragTooltip}">
      <TextBlock
        Text="{loc:Loc WidgetWindow_DragOverlayText}"
        Foreground="White"
        FontSize="11"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsHitTestVisible="False"/>
    </Border>

    <Button
      x:Name="RemoveWidgetButton"
      Width="24"
      Height="20"
      Margin="0,6,28,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Panel.ZIndex="10"
      Content="&#x00D7;"
      Foreground="White"
      Background="#70000000"
      FontSize="16"
      ToolTip="{loc:Loc WidgetWindow_RemoveTooltip}"
      AutomationProperties.Name="{loc:Loc WidgetWindow_RemoveTooltip}"
      Click="RemoveWidgetButton_Click">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Background" Value="#B0B42318"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White"/>
              <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>

    <Grid Name="ResizeHandles"
        IsHitTestVisible="True"
        Panel.ZIndex="9">
      <Border
        Width="18"
        Height="18"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Cursor="SizeNWSE"
        Background="#BFFFFFFF"
        CornerRadius="3"
        MouseLeftButtonDown="TopLeftGrip_MouseLeftButtonDown"
        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
        MouseMove="ResizeGrip_MouseMove"/>

      <Border
        Width="18"
        Height="18"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Cursor="SizeNESW"
        Background="#BFFFFFFF"
        CornerRadius="3"
        MouseLeftButtonDown="TopRightGrip_MouseLeftButtonDown"
        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
        MouseMove="ResizeGrip_MouseMove"/>

      <Border
        Width="18"
        Height="18"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Cursor="SizeNESW"
        Background="#BFFFFFFF"
        CornerRadius="3"
        MouseLeftButtonDown="BottomLeftGrip_MouseLeftButtonDown"
        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
        MouseMove="ResizeGrip_MouseMove"/>

      <Border
        Width="18"
        Height="18"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Cursor="SizeNWSE"
        Background="#BFFFFFFF"
        CornerRadius="3"
        MouseLeftButtonDown="BottomRightGrip_MouseLeftButtonDown"
        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
        MouseMove="ResizeGrip_MouseMove"/>
    </Grid>
  </Grid>
</Window>
