<ui:FluentWindow
  x:Class="HTWind.ProfileNameInputWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:HTWind.Localization"
  Title="{loc:Loc ProfileWindow_Title}"
  Width="440"
  Height="280"
  MinWidth="380"
  MinHeight="240"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  WindowBackdropType="Mica"
  ExtendsContentIntoTitleBar="True"
  WindowCornerPreference="Round">
  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
        Title="{loc:Loc ProfileWindow_Title}"/>

    <StackPanel Grid.Row="1"
        Margin="0,10,0,0">
      <TextBlock
        x:Name="PromptText"
        Margin="0,0,0,8"
        TextWrapping="Wrap"
        Text="{loc:Loc ProfileWindow_NamePrompt}"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

      <ui:TextBox
        x:Name="ProfileNameTextBox"
        MinHeight="34"
        AutomationProperties.Name="{loc:Loc ProfileWindow_NamePrompt}"/>

      <ComboBox
        x:Name="ExistingProfileComboBox"
        Margin="0,10,0,0"
        MinHeight="34"
        Visibility="Collapsed"
        AutomationProperties.Name="{loc:Loc ProfileWindow_NamePrompt}"
        SelectionChanged="ExistingProfileComboBox_SelectionChanged"/>
    </StackPanel>

    <StackPanel
      Grid.Row="2"
      Margin="0,14,0,0"
      Orientation="Horizontal"
      HorizontalAlignment="Right">
      <ui:Button
        Margin="0,0,8,0"
        Content="{loc:Loc WidgetSettings_Cancel}"
        Click="Cancel_Click"/>
      <ui:Button
        x:Name="ConfirmButton"
        Content="{loc:Loc ProfileWindow_ConfirmSave}"
        Appearance="Primary"
        Click="Confirm_Click"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
