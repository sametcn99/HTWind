<ui:FluentWindow
  x:Class="HTWind.HtmlCodeEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
  xmlns:loc="clr-namespace:HTWind.Localization"
  Title="{loc:Loc EditorWindow_Title}"
  Width="980"
  Height="720"
  MinWidth="760"
  MinHeight="520"
  WindowBackdropType="Mica"
  ExtendsContentIntoTitleBar="True"
  WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
        Title="{loc:Loc EditorWindow_Title}"/>

    <Grid Grid.Row="1"
        Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ui:Card Grid.Row="0"
          Padding="12"
          Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <ui:ToggleSwitch
            x:Name="HotReloadToggle"
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="{loc:Loc EditorWindow_HotReload}"
            Checked="HotReload_Changed"
            Unchecked="HotReload_Changed"/>

          <ui:Button
            x:Name="SaveButton"
            Grid.Column="1"
            Margin="12,0,0,0"
            Content="{loc:Loc EditorWindow_Save}"
            Appearance="Primary"
            Click="Save_Click"/>

          <ui:Button
            x:Name="SaveAllButton"
            Grid.Column="2"
            Margin="8,0,0,0"
            Content="{loc:Loc EditorWindow_SaveAll}"
            Click="SaveAll_Click"/>

          <ui:Button
            x:Name="ConsoleToggleButton"
            Grid.Column="3"
            Margin="8,0,0,0"
            Content="{loc:Loc EditorWindow_Console}"
            Click="ConsoleToggle_Click"/>

          <ui:Button
            Grid.Column="4"
            Margin="8,0,0,0"
            HorizontalAlignment="Right"
            Content="{loc:Loc EditorWindow_Close}"
            Click="Close_Click"/>
        </Grid>
      </ui:Card>

      <TabControl
        x:Name="FileTabs"
        Grid.Row="1"
        Margin="0,0,0,8"
        Background="Transparent"
        BorderThickness="0"
        SelectionChanged="FileTabs_SelectionChanged"/>

      <Border
        Grid.Row="2"
        CornerRadius="10"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <wv2:WebView2 x:Name="EditorWebView"/>
      </Border>

      <Grid
        x:Name="ConsolePanel"
        Grid.Row="3"
        Margin="0,10,0,0"
        Height="180"
        Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
            Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="0"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Text="{loc:Loc EditorWindow_Console}"/>
          <ui:Button
            Grid.Column="1"
            Content="{loc:Loc EditorWindow_ConsoleClear}"
            Click="ConsoleClear_Click"/>
        </Grid>
        <Border
          Grid.Row="1"
          CornerRadius="8"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1">
          <ListBox
            x:Name="ConsoleList"
            Background="Transparent"
            BorderThickness="0"
            FontFamily="Consolas"
            FontSize="12"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
