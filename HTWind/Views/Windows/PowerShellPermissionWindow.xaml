<ui:FluentWindow
  x:Class="HTWind.PowerShellPermissionWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:HTWind.Localization"
  Title="{loc:Loc PowerShellPermissionDialog_Title}"
  Width="620"
  Height="470"
  MinWidth="560"
  MinHeight="420"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  WindowBackdropType="Mica"
  ExtendsContentIntoTitleBar="True"
  WindowCornerPreference="Round">
  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
        Title="{loc:Loc PowerShellPermissionDialog_Title}"/>

    <ui:Card Grid.Row="1"
        Margin="0,10,0,10"
        Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
          Grid.Row="0"
          FontSize="22"
          FontWeight="SemiBold"
          Text="{loc:Loc PowerShellPermissionDialog_Header}"/>

        <TextBlock
          Grid.Row="1"
          Margin="0,8,0,0"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{loc:Loc PowerShellPermissionDialog_Description}"/>

        <TextBlock
          x:Name="WidgetValueText"
          Grid.Row="2"
          Margin="0,8,0,0"
          FontWeight="SemiBold"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
      </Grid>
    </ui:Card>

    <StackPanel
      Grid.Row="2"
      HorizontalAlignment="Right">
      <StackPanel.Resources>
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
          <Setter Property="MinWidth" Value="170"/>
          <Setter Property="Margin" Value="6,2,6,2"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
      </StackPanel.Resources>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ui:Button
          Grid.Column="0"
          Content="{loc:Loc PowerShellPermissionDialog_ReadOnly}"
          ToolTip="{loc:Loc PowerShellPermissionDialog_ReadOnlyHint}"
          Click="ReadOnly_Click"/>
        <ui:Button
          Grid.Column="1"
          Appearance="Primary"
          Content="{loc:Loc PowerShellPermissionDialog_Full}"
          ToolTip="{loc:Loc PowerShellPermissionDialog_FullHint}"
          Click="Full_Click"/>
        <ui:Button
          Grid.Column="2"
          Content="{loc:Loc PowerShellPermissionDialog_Deny}"
          ToolTip="{loc:Loc PowerShellPermissionDialog_DenyHint}"
          Click="Deny_Click"/>
      </Grid>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
