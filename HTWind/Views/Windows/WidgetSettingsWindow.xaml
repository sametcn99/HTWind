<ui:FluentWindow
  x:Class="HTWind.WidgetSettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:HTWind.Localization"
  Title="{loc:Loc WidgetSettings_Title}"
  Width="520"
  Height="520"
  MinWidth="460"
  MinHeight="380"
  ResizeMode="CanResize"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  WindowBackdropType="Mica"
  ExtendsContentIntoTitleBar="True"
  WindowCornerPreference="Round">
  <Grid Margin="18,14,18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
        Title="{loc:Loc WidgetSettings_Title}"/>

    <Border
      Grid.Row="1"
      Margin="0,10,0,10"
      CornerRadius="8"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
          x:Name="SettingsHost"
          Margin="14"
          Orientation="Vertical"/>
      </ScrollViewer>
    </Border>

    <StackPanel
      Grid.Row="2"
      Orientation="Horizontal"
      HorizontalAlignment="Right">
      <ui:Button
        Margin="0,0,8,0"
        Content="{loc:Loc WidgetSettings_Cancel}"
        Click="Cancel_Click"/>
      <ui:Button
        x:Name="SaveButton"
        Content="{loc:Loc WidgetSettings_Save}"
        Appearance="Primary"
        Click="Save_Click"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
